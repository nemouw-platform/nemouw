# Copy to .env, fill in and remove inline comments. Generate secrets: openssl rand -base64 48
# Each secret must be unique and at least 32 random bytes

# ---- Required: the app refuses to start while any of these is empty ----
# App
URL_BASE=https://nemouw.com

# Auth & Security
JWT_SECRET=
OTP_HASH_SECRET=

# ---- Local development settings (change for staging and production) ----
# Networking / Cookies
TRUST_PROXY=false            # true ONLY when running behind a trusted reverse proxy
COOKIE_SECURE=false          # must be true in staging/production (HTTPS)
ALLOW_LOCALHOST_ORIGINS=true # must be false in staging/production

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=

# ---- Optional (uncomment to change the default) ----
# Sender shown to recipients. Default: onboarding@resend.dev
# MAIL_FROM=Nemouw <no-reply@yourdomain.com>
# Requests per second per IP before a 429. Default: 5
# DDOS_SHIELD_REQUEST_LIMIT_PER_SECOND=5
# Set false where migrations are run separately. Default: true
# FLYWAY_ENABLED=true
# Also write a rolling log file. Default: console only
# LOG_FILE=logs/app.log
