<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%X{trace_id}] %logger{20} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="warn"><AppenderRef ref="Console"/></Root>
        <Logger name="com.nemouw" level="info"/>
    </Loggers>
</Configuration>