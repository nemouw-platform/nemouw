# Copy to .env.local and adjust. No secrets here: secrets live in backend/.env.

# Backend URL used by the BROWSER (client components).
# Must be the backend's PUBLIC address, reached through Nginx over HTTPS.
# Inlined into the JS bundle at build time: changing it requires a rebuild.
#   Local:       http://localhost:8080
#   Production:  https://api.domain.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend URL used by the NEXT.JS SERVER (Server Components, server actions).
# Never sent to the browser. Read at runtime.
# In Docker, use the backend's compose SERVICE NAME, not localhost:
# inside a container, localhost means that container itself.
#   Local:       http://localhost:8080
#   Production:  http://backend:8080
API_URL=http://localhost:8080
