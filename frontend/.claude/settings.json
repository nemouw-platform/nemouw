{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev)", "Bash(pnpm build)", "Bash(pnpm lint)", "Bash(pnpm lint *)",
      "Bash(pnpm start)", "Bash(pnpm exec tsc *)",
      "Bash(pnpm dlx shadcn@latest add *)", "Bash(pnpm dlx shadcn@latest view *)",
      "Bash(pnpm dlx shadcn@latest search *)",
      "PowerShell(pnpm dev)", "PowerShell(pnpm build)", "PowerShell(pnpm lint)", "PowerShell(pnpm lint *)",
      "PowerShell(pnpm start)", "PowerShell(pnpm exec tsc *)",
      "PowerShell(pnpm dlx shadcn@latest add *)", "PowerShell(pnpm dlx shadcn@latest view *)",
      "PowerShell(pnpm dlx shadcn@latest search *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)",
      "Read(./.env.development)", "Read(./.env.production)", "Read(./.env.test)"
    ]
  }
}
