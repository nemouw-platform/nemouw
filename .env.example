# Copy to .env, fill in and remove inline comments. Generate secrets: openssl rand -base64 48
# Each secret must be unique and at least 32 random bytes

# App
APP_ENV=dev      # dev | staging | production
LOG_LEVEL=debug  # debug | info | warn | error
URL_BASE=https://nemouw.com

# Database (PostgresSQL)
DB_URL=jdbc:postgresql://db:5432/nemouw?user=postgres&password=password  # generate a unique password
POSTGRES_DB=nemouw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Auth & Security
JWT_SECRET=
OTP_HASH_SECRET=

# Networking / Cookies
TRUST_PROXY=false            # true ONLY when running behind a trusted reverse proxy
COOKIE_SECURE=false          # must be true in staging/production (HTTPS)
ALLOW_LOCALHOST_ORIGINS=true # must be false in staging/production

# Email (Resend)
RESEND_API_KEY=